        {
          "name": "Create customer (chaining 1/2)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Genera un email dinamico para que el POST no falle por email duplicado",
                  "const randomSuffix = Math.floor(Math.random() * 1000000);",
                  "const dynamicEmail = `qa.candidate.${randomSuffix}@mail.com`;",
                  "pm.environment.set(\"dynamicEmail\", dynamicEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "",
                  "pm.test(\"Response time is less than 500ms\", () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "pm.test(\"Schema: created customer has required fields\", () => {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"data\");",
                  "    [\"id\", \"firstName\", \"lastName\", \"email\"].forEach((field) => {",
                  "        pm.expect(jsonData.data).to.have.property(field);",
                  "    });",
                  "    pm.expect(jsonData.data.email).to.eql(pm.environment.get(\"dynamicEmail\"));",
                  "});",
                  "",
                  "pm.test(\"Save customerId to environment for chaining\", () => {",
                  "    const jsonData = pm.response.json();",
                  "    pm.environment.set(\"customerId\", jsonData.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"QA\",\n  \"lastName\": \"Candidate\",\n  \"email\": \"{{dynamicEmail}}\",\n  \"phone\": \"04140000000\",\n  \"identification\": \"V00000000\",\n  \"city\": \"Caracas\",\n  \"nationality\": \"VE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          },
          "response": []
        },
